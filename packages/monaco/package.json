{
    "name": "@coderline/alphatab-monaco",
    "version": "1.9.0",
    "description": "A Monaco editor integration for alphaTab providing coding assistance for alphaTex.",
    "keywords": [
        "guitar",
        "music-notation",
        "music-sheet",
        "html5",
        "svg",
        "guitar-tablature",
        "alphaTab",
        "alphaTex"
    ],
    "homepage": "https://alphatab.net",
    "bugs": {
        "url": "https://github.com/coderline/alphaTab/issues"
    },
    "author": "Daniel Kuschny",
    "license": "MPL-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CoderLine/alphaTab.git"
    },
    "scripts": {
        "clean": "rimraf dist",
        "lint": "biome lint",
        "typecheck": "tsc --noEmit",
        "build": "vite build",
        "dev": "vite build --watch",
        "test": "vitest run",
        "test-web": "npm run test"
    },
    "dependencies": {
        "@coderline/alphatab": "^1.9.0",
        "@coderline/alphatab-language-server": "^1.9.0",
        "monaco-editor": "^0.57.0",
        "vscode-languageserver": "^11.0.0",
        "vscode-languageserver-protocol": "^3.18.4",
        "vscode-languageserver-textdocument": "^1.0.15",
        "vscode-languageserver-types": "^3.17.5",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.3",
        "@microsoft/api-extractor": "^7.60.0",
        "@types/node": "^26.6.5",
        "rimraf": "^6.1.3",
        "tslib": "^2.8.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5"
    },
    "bin": "./dist/alphaTab.monaco.mjs",
    "main": "./dist/alphaTab.monaco.mjs",
    "types": "./dist/alphaTab.monaco.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/alphaTab.monaco.d.ts",
            "default": "./dist/alphaTab.monaco.mjs"
        },
        "./alphatex": {
            "types": "./dist/alphatex.d.ts",
            "default": "./dist/alphatex.mjs"
        },
        "./lsp": {
            "types": "./dist/lsp.d.ts",
            "default": "./dist/lsp.mjs"
        },
        "./lspMonacoMappings": {
            "types": "./dist/lspMonacoMappings.d.ts",
            "default": "./dist/lspMonacoMappings.mjs"
        },
        "./textmate": {
            "types": "./dist/textmate.d.ts",
            "default": "./dist/textmate.mjs"
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "default": "./dist/types.mjs"
        },
        "./worker": {
            "types": "./dist/worker.d.ts",
            "default": "./dist/worker.mjs"
        },
        "./dist/*.mjs": "./dist/*.mjs",
        "./dist/*": {
            "types": "./dist/*.d.ts",
            "default": "./dist/*.mjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "/dist/",
        "!/dist/types/",
        "README.md",
        "LICENSE",
        "LICENSE.header"
    ]
}
