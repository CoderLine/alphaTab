{
    "name": "@coderline/alphatab-kotlin",
    "version": "1.10.0",
    "description": "The Kotlin target of alphaTab.",
    "private": true,
    "type": "module",
    "scripts": {
        "clean": "rimraf src/core/src/main-generated && rimraf src/core/src/test-generated",
        "transpile": "tsx scripts/transpile.ts",
        "build": "npm run transpile && node scripts/gradlew.mjs assemble",
        "test": "node scripts/gradlew.mjs :core:check --info"
    }
}
