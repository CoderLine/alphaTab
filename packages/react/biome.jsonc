{
    "$schema": "https://biomejs.dev/schemas/2.2.5/schema.json",
    "root": false,
    "extends": "//",
    "files": {
        "includes": [
            "*.ts",
            "src/**",
            "test/**"
        ]
    },
    "formatter": {
        "includes": [
            "*.ts",
            "src/**",
            "test/**"
        ]
    },
    "linter": {
        "includes": [
            "*.ts",
            "src/**",
            "test/**"
        ],
        "rules": {
            "style": {
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "patterns": [
                            {
                                "group": [
                                    "@coderline/alphatab-ui",
                                    "@coderline/alphatab-ui/**",
                                    "@docusaurus/**",
                                    "@site/**",
                                    "@theme/**",
                                    "**/*.css",
                                    "**/*.scss"
                                ],
                                "message": "@coderline/alphatab-react is the low-level layer: no UI package, Docusaurus or stylesheet imports."
                            }
                        ]
                    }
                }
            }
        }
    }
}