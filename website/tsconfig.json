{
  // Mirrors @docusaurus/tsconfig without its baseUrl, which TypeScript 6 rejects.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "ES2024.Promise", "ESNext.Disposable"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "types": ["node", "@docusaurus/module-type-aliases"]
  },
  "include": ["*.ts", "*.mts", "src/", "scripts/", "docs/**/_chapters.ts"]
}
