<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 4.0 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<!--
  Twinkle, Twinkle Little Star (theme from "Ah, vous dirai-je, Maman",
  K.265/300e) - W.A. Mozart (1756-1791). Public Domain.

  Two parts wrapped in a single part-group (brace) so alphaTab's
  `importer.mergePartGroupsInMusicXml` demo has a real grand-staff to
  fold into one piano track. Melody 1:1 from Neue Mozart-Ausgabe;
  LH accompaniment is a plain root-position C major triad on beats 1/3.
-->
